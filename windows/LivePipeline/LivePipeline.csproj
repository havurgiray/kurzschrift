<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prototype of the Windows live pipeline: capture, VAD, Parakeet, OPUS-MT. No UI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <!-- Managed API only: it uses the onnxruntime.dll that sherpa-onnx ships (1.28.2). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
</Project>
